<?xml version="1.0" encoding="UTF-8"?>
<language_definitions>
  <!-- The stock PowerPC:BE:64:A2ALT-32addr language plus the Cell PPU vector load/store
       left/right instructions. Processor, size and registers stay those of PowerPC so Ghidra's
       PowerPC ELF support and analyzers apply. -->
  <language processor="PowerPC"
            endian="big"
            size="32"
            variant="CellPPU-32addr"
            version="1.0"
            slafile="ppc_cell.sla"
            processorspec="ppc_64.pspec"
            id="PowerPC:BE:64:CellPPU-32addr">
    <description>Cell Broadband Engine PPU: Power ISA 3.0 Big Endian w/Altivec and 32-bit Addressing, plus the Cell vector load/store left/right instructions</description>
    <truncate_space space="ram" size="4"/>
    <compiler name="default" spec="ppc_64_32.cspec" id="default"/>
    <external_name tool="gnu" name="powerpc:e500mc64"/>
    <external_name tool="IDA-PRO" name="ppc"/>
    <external_name tool="DWARF.register.mapping.file" name="ppc.dwarf"/>
    <external_name tool="qemu" name="qemu-ppc64abi32"/>
    <external_name tool="qemu_system" name="qemu-system-ppc64"/>
  </language>
</language_definitions>
